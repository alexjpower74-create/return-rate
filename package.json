{
  "name": "return-rate",
  "version": "0.1.0",
  "private": true,
  "description": "Return Rate: scan a container's barcode, get the exact Newfoundland refund.",
  "type": "module",
  "scripts": {
    "test": "playwright test && npm --prefix worker run test:rules",
    "test:app": "cd app/tests && npx playwright test",
    "test:qa": "playwright test app/tests/qa",
    "test:phone": "playwright test --project=chromium-phone --project=webkit-phone",
    "test:red": "QA_TARGET=/app/tests/qa/fixture/stand-in.html?plant=1 playwright test app/tests/qa/plain-english.spec.js --project=chromium-phone",
    "serve:qa": "node app/tests/qa/serve.mjs",
    "live": "node tests/live-roundtrip.mjs",
    "dev": "echo 'Two terminals: cd worker && npm run dev (API on 5902), then npm run serve:qa. See README.md'",
    "check": "biome ci . && npm test && check-no-personal-data --quiet ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@biomejs/biome": "2.5.13"
  }
}
